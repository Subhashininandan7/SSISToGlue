<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SSISGlueDemo</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../engine/**" CopyToOutputDirectory="PreserveNewest" Link="engine/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../fixtures/**" CopyToOutputDirectory="PreserveNewest" Link="fixtures/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../glue/**" CopyToOutputDirectory="PreserveNewest" Link="glue/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
