  <DTS:Executables><DTS:Executable DTS:refId="Package\Transform Active Employees Using PowerShell" DTS:CreationName="Microsoft.ExecuteProcess" DTS:Description="Unsupported SCT Execute Process Task. Business rule: read Employees.csv; filter Status==Active; calculate Bonus=Salary*0.10 with 2 decimal places; output ActiveEmployees.csv. Full implementation: transform.ps1." DTS:DTSID="{58FF865F-9195-4850-A570-A687C2161DE0}" DTS:ExecutableType="Microsoft.ExecuteProcess" DTS:LocaleID="-1" DTS:ObjectName="Transform Active Employees Using PowerShell" DTS:ThreadHint="0" DTS:TaskContact="Execute Process Task;Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"><DTS:Variables/><DTS:ObjectData><ExecuteProcessData Executable="powershell.exe" Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;D:\MigrationForgeUnsupportedDemo\transform.ps1&quot;" WorkingDirectory="D:\MigrationForgeUnsupportedDemo" FailTaskIfReturnCodeIsNotSuccessValue="True" SuccessValue="0"/></DTS:ObjectData></DTS:Executable></DTS:Executables></DTS:Executable>
