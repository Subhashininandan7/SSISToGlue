  <DTS:Executables><DTS:Executable DTS:refId="Package\Prepare Isolated Demo SCD2 Tables" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL Task" DTS:DTSID="{C9484939-356D-4715-AE0E-2D9909A0F6F2}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="Prepare Isolated Demo SCD2 Tables" DTS:ThreadHint="0"><DTS:Variables/><DTS:ObjectData><SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{B6F42411-CD75-4FAD-82AF-078030A6FB58}" SQLTask:SqlStatementSource="  IF OBJECT_ID('dbo.DemoForgeDimCustomer','U') IS NULL CREATE TABLE dbo.DemoForgeDimCustomer(CustomerID varchar(120), CustomerName varchar(120), City varchar(120), EffectiveFrom varchar(12), EffectiveTo varchar(12), IsCurrent int);&#10;  IF OBJECT_ID('dbo.DemoForgeChanges','U') IS NULL CREATE TABLE dbo.DemoForgeChanges(CustomerID varchar(120), CustomerName varchar(120), City varchar(120));&#10;  DELETE FROM dbo.DemoForgeDimCustomer;&#10;  DELETE FROM dbo.DemoForgeChanges;&#10;  BULK INSERT dbo.DemoForgeDimCustomer FROM 'D:\SSISGlueDemo\fixtures\input\DimCustomer.csv' WITH (FIRSTROW=2,FIELDTERMINATOR=',',ROWTERMINATOR='0x0a',CODEPAGE='ACP');&#10;  BULK INSERT dbo.DemoForgeChanges FROM 'D:\SSISGlueDemo\fixtures\input\CustomerChanges.csv' WITH (FIRSTROW=2,FIELDTERMINATOR=',',ROWTERMINATOR='0x0a',CODEPAGE='ACP');&#10;  UPDATE dbo.DemoForgeDimCustomer SET CustomerID=RTRIM(CustomerID),CustomerName=RTRIM(CustomerName),City=RTRIM(City),EffectiveFrom=RTRIM(EffectiveFrom),EffectiveTo=RTRIM(EffectiveTo);&#10;  UPDATE dbo.DemoForgeChanges SET CustomerID=RTRIM(CustomerID),CustomerName=RTRIM(CustomerName),City=RTRIM(City);&#10;"/></DTS:ObjectData></DTS:Executable><DTS:Executable DTS:refId="Package\Expire Changed and Insert New Versions" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL Task" DTS:DTSID="{459E5478-14E8-42F7-BC63-3081DE76DFD3}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="Expire Changed and Insert New Versions" DTS:ThreadHint="0"><DTS:Variables/><DTS:ObjectData><SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{B6F42411-CD75-4FAD-82AF-078030A6FB58}" SQLTask:SqlStatementSource="  SET XACT_ABORT ON;&#10;  BEGIN TRANSACTION;&#10;  UPDATE cur&#10;  SET IsCurrent=0,EffectiveTo='2026-11-08'&#10;  FROM dbo.DemoForgeDimCustomer cur&#10;  JOIN dbo.DemoForgeChanges ch ON cur.CustomerID=ch.CustomerID&#10;  WHERE cur.IsCurrent=1 AND (cur.CustomerName&lt;&gt;ch.CustomerName OR cur.City&lt;&gt;ch.City);&#10;  INSERT INTO dbo.DemoForgeDimCustomer(CustomerID,CustomerName,City,EffectiveFrom,EffectiveTo,IsCurrent)&#10;  SELECT ch.CustomerID,ch.CustomerName,ch.City,'2026-11-08','9999-12-31',1&#10;  FROM dbo.DemoForgeChanges ch&#10;  LEFT JOIN dbo.DemoForgeDimCustomer cur ON cur.CustomerID=ch.CustomerID AND cur.IsCurrent=1&#10;  WHERE cur.CustomerID IS NULL;&#10;  COMMIT TRANSACTION;&#10;"/></DTS:ObjectData></DTS:Executable><DTS:Executable DTS:refId="Package\Export Customer History to CSV" DTS:CreationName="Microsoft.Pipeline" DTS:Description="Data Flow Task" DTS:DTSID="{1DB2CF22-6D8F-4159-8765-21E1DBAC1560}" DTS:ExecutableType="Microsoft.Pipeline" DTS:LocaleID="-1" DTS:ObjectName="Export Customer History to CSV" DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:Variables/>
